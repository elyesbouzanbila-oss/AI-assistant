# Copy to .env and fill in. Read by the Rust process only - never sent to the webview.
# .env is gitignored.
# The former JARVIS_* names are still read as a fallback; ALFRED_* wins if both
# are set, so an existing .env does not need editing.

# --- OpenRouter (one key, most models) ----------------------------------
# Base URL and protocol are OpenAI-compatible, so model ids use author/slug form.
# Pick a model that supports BOTH tool calling and image input:
#   google/gemini-2.5-flash        cheap, fast, vision + tools   (good default)
#   anthropic/claude-sonnet-4.5    strongest at multi-step UI tasks
#   openai/gpt-4o-mini             cheap, vision + tools
#   moonshotai/kimi-k2            if you want a non-Western option
# Browse with filters: https://openrouter.ai/models?supported_parameters=tools,vision
#
# A text-only model cannot take screenshots. ALFRED_VISION=false removes the
# screenshot tool entirely, so a turn never dies on an image it would refuse.
# ALFRED_VISION=true
# (":free" variants work but are rate limited and often skip tool calling.)
ALFRED_BASE_URL=https://openrouter.ai/api/v1
ALFRED_API_KEY=
ALFRED_MODEL=google/gemini-2.5-flash

# --- voice transcription (optional) ------------------------------------
# Who turns the recording into text. The text model answers the turn either way.
# ALFRED_STT_PROVIDER=model        # model (default), windows or whisper
#
# With "windows" the WAV is recognised offline by Windows System.Speech:
# no voice model, endpoint or key is needed (accuracy is lower than a cloud
# audio model, and the speech language pack must be installed).
#
# With "whisper" the WAV is sent to whisper.cpp running inside WSL Debian.
# Both paths are Linux-side: the command (on PATH or a full path) and the
# GGUF model path. The Windows temp WAV is mounted at /mnt/c/... for the run.
# ALFRED_WHISPER_BIN=whisper-cli
# ALFRED_WHISPER_MODEL=/home/Chief/whisper.cpp/models/ggml-small.en.bin
#
# Unset means "use ALFRED_MODEL", which must then accept audio input.
# Set ALFRED_STT_MODEL when the main model is text-only or runs locally.
# ALFRED_STT_MODEL=google/gemini-2.5-flash
#
# Voice may live on a different endpoint and key than chat, so a local Ollama
# model can take dictation from a cloud service. Set both or neither: a
# separate endpoint never inherits ALFRED_API_KEY.
# ALFRED_STT_BASE_URL=https://openrouter.ai/api/v1
# ALFRED_STT_API_KEY=sk-or-v1-...

# Optional: identifies this app in OpenRouter's rankings (sent as HTTP-Referer).
# Sent only when ALFRED_BASE_URL points at openrouter.ai; ignored otherwise.
# ALFRED_SITE_URL=https://example.com

# --- fallback: a local model when the one above fails -------------------
# Tried once when the primary endpoint errors (rate limit, outage, no network).
# Both values are required; leave either unset to turn the fallback off.
# On Windows the app starts WSL and `ollama serve` itself when nothing is
# listening, then loads the model - no terminal needed.
# ALFRED_FALLBACK_BASE_URL=http://localhost:11434/v1
# ALFRED_FALLBACK_MODEL=minicpm5:latest
#
# A loopback fallback needs no key. A remote one does, and never inherits
# ALFRED_API_KEY:
# ALFRED_FALLBACK_API_KEY=

# Speaking the answer back, for turns you started by dictating. Windows SAPI:
# offline, no key, no extra dependency. Type your prompt and it stays silent.
# ALFRED_SPEAK=true
# ALFRED_VOICE=Microsoft Zira Desktop   # blank = the system default voice
# ALFRED_SPEECH_RATE=0                  # -10 (slow) to 10 (fast)

# --- other OpenAI-compatible endpoints ----------------------------------
# Z.ai GLM
# ALFRED_BASE_URL=https://api.z.ai/api/paas/v4
# ALFRED_MODEL=glm-4.6v
#
# OpenAI
# ALFRED_BASE_URL=https://api.openai.com/v1
# ALFRED_MODEL=gpt-4o-mini
#
# --- fully local with Ollama: no key, nothing leaves your PC -------------
# `ollama pull qwen2.5vl` - the model must do tool calling AND image input.
# ALFRED_BASE_URL=http://localhost:11434/v1
# ALFRED_MODEL=qwen2.5vl
# Leave ALFRED_API_KEY empty: a loopback endpoint needs no key.
# Voice is the exception: Ollama takes no audio input. Either point voice at a
# cloud audio model, or set ALFRED_STT_PROVIDER=windows to transcribe locally.

# Max tool steps per request before Alfred stops and reports back.
ALFRED_MAX_STEPS=8
