# Copy to .env and fill in. Read by the Rust process only - never sent to the webview.
# .env is gitignored.

# --- OpenRouter (one key, most models) ----------------------------------
# Base URL and protocol are OpenAI-compatible, so model ids use author/slug form.
# Pick a model that supports BOTH tool calling and image input:
#   google/gemini-2.5-flash        cheap, fast, vision + tools   (good default)
#   anthropic/claude-sonnet-4.5    strongest at multi-step UI tasks
#   openai/gpt-4o-mini             cheap, vision + tools
#   moonshotai/kimi-k2            if you want a non-Western option
# Browse with filters: https://openrouter.ai/models?supported_parameters=tools,vision
# (":free" variants work but are rate limited and often skip tool calling.)
JARVIS_BASE_URL=https://openrouter.ai/api/v1
JARVIS_API_KEY=
JARVIS_MODEL=google/gemini-2.5-flash

# Optional: model used to transcribe voice dictation. Unset means "use
# JARVIS_MODEL", which must then accept audio input (gemini-2.5-flash does).
# Set this only if the main model is text-only; it must be on the same endpoint.
# JARVIS_STT_MODEL=google/gemini-2.5-flash

# Optional: identifies this app in OpenRouter's rankings (sent as HTTP-Referer).
# Sent only when JARVIS_BASE_URL points at openrouter.ai; ignored otherwise.
# JARVIS_SITE_URL=https://example.com

# --- other OpenAI-compatible endpoints ----------------------------------
# Z.ai GLM
# JARVIS_BASE_URL=https://api.z.ai/api/paas/v4
# JARVIS_MODEL=glm-4.6v
#
# OpenAI
# JARVIS_BASE_URL=https://api.openai.com/v1
# JARVIS_MODEL=gpt-4o-mini
#
# Fully local, nothing leaves your PC (Ollama running, e.g. `ollama pull qwen2.5vl`)
# JARVIS_BASE_URL=http://localhost:11434/v1
# JARVIS_API_KEY=ollama
# JARVIS_MODEL=qwen2.5vl

# Max tool steps per request before Jarvis stops and reports back.
JARVIS_MAX_STEPS=8
